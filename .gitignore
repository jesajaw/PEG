# ---- Compiled code ----------------------------------------------------
# Object files: one .o per .cpp file, created by "make" / qmake.
*.o
*.obj

# Dependency files created by the Makefile (the -MMD flag). They only tell make which headers a .cpp file uses.
*.d

# Libraries, precompiled headers and debug leftovers.
*.a
*.so
*.so.*
*.dylib
*.gch
*.dSYM/

# All build products: objects (make: build/obj, qmake: build/qt) ...
/build/
# ... and the finished programs in the project root (make, or qmake via DESTDIR).
/pegSerial
/pegMPI
/pegSerial.exe
/pegMPI.exe

# Crash dumps.
/core
/core.[0-9]*
vgcore.*

# ---- Generated build files --------------------------------------------
# (The root Makefile is hand-written and tracked. qmake output goes to build/qt, which is ignored above.)

# More qmake / Qt Creator leftovers.
.qmake.stash
.qmake.cache
object_script.*
*.pro.user
*.pro.user.*
*.autosave
/build-*/
/debug/
/release/
moc_*
ui_*
qrc_*


# ---- Calculation results ----------------------------------------------
/output/
/run/output/
/benchmark_results/
*.partial
*.FAILED
*.txt
*.csv

*.o[0-9]*
*.e[0-9]*


# ---- Editors and operating systems ------------------------------------
.vscode/
.idea/
.vs/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini


# ---- Bundled third-party sources must be tracked completely ------------
# (placed last so it overrides the *.txt / *.o rules above, e.g. CMakeLists.txt inside Eigen)
!/third_party/
!/third_party/**
