# ---- Compiled code ----------------------------------------------------
# Object files: one .o per .cpp file, created by "make" / qmake.
*.o
*.obj

# Dependency files created by src/Makefile.example (the -MMD flag). They only tell make which headers a .cpp file uses.
*.d

# Libraries, precompiled headers and debug leftovers.
*.a
*.so
*.so.*
*.dylib
*.gch
*.dSYM/

# The finished programs (built from PEG_*.pro or from src/Makefile).
pegSerial
pegMPI
pegSerial.exe
pegMPI.exe

# Crash dumps.
/core
/core.[0-9]*
vgcore.*

# More qmake / Qt Creator leftovers.
.qmake.stash
.qmake.cache
object_script.*
*.pro.user
*.pro.user.*
*.autosave
/build/
/debug/
/release/
moc_*
ui_*
qrc_*


# ---- Calculation results ----------------------------------------------
/benchmark_results/
*.partial
*.FAILED

*.o[0-9]*
*.e[0-9]*


# ---- Editors and operating systems ------------------------------------
.vscode/
.idea/
.vs/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini